#include <dt-bindings/zmk/matrix_transform.h>
#include "gigas_layouts.dtsi"

/ {
    chosen {
        zmk,physical-layout = &gigas_layout;
    };

    gigas_transform: keymap_transform {
        compatible = "zmk,matrix-transform";
        columns = <7>;
        rows = <6>;
        map = <
RC(0,0) RC(3,0) RC(0,1) RC(3,1)                                         RC(3,3) RC(0,3) RC(3,4) RC(0,4)
RC(1,0) RC(4,0) RC(1,1) RC(4,1) RC(0,2)         RC(1,6)         RC(3,2) RC(4,3) RC(1,3) RC(4,4) RC(1,4)
RC(2,0) RC(5,0) RC(2,1) RC(5,1) RC(1,2) RC(3,6) RC(5,6) RC(2,6) RC(4,2) RC(5,3) RC(2,3) RC(5,4) RC(2,4)
                                RC(2,5) RC(2,2) RC(4,6) RC(5,2) RC(5,5)
        >;
    };
};

// vim: expandtab softtabstop=4 shiftwidth=4
